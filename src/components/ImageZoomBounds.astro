<script>
    // The zoom plugin uses viewport dimensions for SVGs. Use their viewBox instead
    // so cropped screenshots keep their actual proportions and pixel dimensions.
    const fitZoom = (dialog: HTMLDialogElement) => {
        const source = document.querySelector<SVGSVGElement | HTMLImageElement>('.starlight-image-zoom-source');
        const image = dialog.querySelector<SVGSVGElement | HTMLImageElement>('.starlight-image-zoom-image');
        if (!source || !image) return;

        const svg = source instanceof SVGSVGElement;
        const naturalWidth = svg ? source.viewBox.baseVal.width : source.naturalWidth;
        const naturalHeight = svg ? source.viewBox.baseVal.height : source.naturalHeight;
        if (!naturalWidth || !naturalHeight) return;

        const gutter = window.innerWidth < 600 ? 24 : 48;
        const scale = Math.min(1, 960 / naturalWidth, (window.innerWidth - gutter) / naturalWidth, window.innerHeight * 0.75 / naturalHeight);
        const width = naturalWidth * scale;
        const height = naturalHeight * scale;
        const left = (window.innerWidth - width) / 2;
        const top = (window.innerHeight - height) / 2;
        const bounds = source.getBoundingClientRect();
        const scaleX = bounds.width / width;
        const scaleY = bounds.height / height;
        const translateX = (bounds.left - left + (bounds.width - width) / 2) / scaleX;
        const translateY = (bounds.top - top + (bounds.height - height) / 2) / scaleY;
        const transform = `scale(${scaleX}, ${scaleY}) translate3d(${translateX}px, ${translateY}px, 0)`;

        Object.assign(image.style, {
            width: `${width}px`, height: `${height}px`, left: `${left}px`, top: `${top}px`, transform,
        });
        // Keep the plugin's opening and closing animations aligned with the source.
        image.dataset.zoomTransform = transform;
    };

    // The plugin portals each dialog into body before starting its animation.
    new MutationObserver((records) => {
        for (const record of records) {
            for (const node of record.addedNodes) {
                if (!(node instanceof Element)) continue;
                const dialog = node.matches('.starlight-image-zoom-dialog')
                    ? node
                    : node.querySelector('.starlight-image-zoom-dialog');
                if (dialog instanceof HTMLDialogElement && dialog.open) fitZoom(dialog);
            }
        }
    }).observe(document.body, { childList: true });
</script>
