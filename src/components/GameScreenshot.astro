---
import { Zoom } from 'starlight-image-zoom/components';

interface Props {
    src: string;
    alt: string;
    crop: [number, number, number, number];
}

const { src, alt, crop } = Astro.props;
const [left, top, width, height] = crop;
---

<div class="game-screenshot">
    <Zoom label={alt}>
        <svg viewBox={`${left} ${top} ${width} ${height}`} width={width} height={height} role="img" aria-label={alt}>
            <title>{alt}</title>
            <image href={src} width="1920" height="1080" />
        </svg>
    </Zoom>
</div>

<style>
    .game-screenshot {
        display: block;
        overflow: hidden;
        margin-block: 1.5rem;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.625rem;
        line-height: 0;
    }

    .game-screenshot svg {
        display: block;
        width: 100%;
        height: auto;
        overflow: hidden;
    }

</style>
