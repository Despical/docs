---
import { Zoom } from 'starlight-image-zoom/components';

interface Props {
    src: string;
    alt: string;
    crop?: [number, number, number, number];
    width?: number;
    height?: number;
}

const { src, alt, crop, width = 1920, height = 1080 } = Astro.props;
---

<div class="game-screenshot" style={!crop ? `--screenshot-width: ${width + 2}px` : undefined}>
    <Zoom label={alt}>
        {crop ? (
            <svg viewBox={crop.join(' ')} width={crop[2]} height={crop[3]} role="img" aria-label={alt}>
                <title>{alt}</title>
                <image href={src} width={width} height={height} />
            </svg>
        ) : (
            <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
        )}
    </Zoom>
</div>

<style>
    .game-screenshot {
        display: block;
        width: 100%;
        max-width: var(--screenshot-width, 100%);
        overflow: hidden;
        margin-block: 1.5rem;
        margin-inline: auto;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.625rem;
        line-height: 0;
    }

    .game-screenshot :is(svg, img) {
        display: block;
        width: 100%;
        height: auto;
        overflow: hidden;
    }

</style>
