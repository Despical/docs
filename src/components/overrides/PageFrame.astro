---
import MobileMenuToggle from "@astrojs/starlight/components/MobileMenuToggle.astro";
import TopicsDropdown from "./TopicsDropdown.astro";

const { hasSidebar } = Astro.locals.starlightRoute;
const showSidebar = hasSidebar;
---

<div class:list={["page sl-flex", !showSidebar && "page--without-sidebar"]}>
    <header class="header"><slot name="header" /></header>
    {
        showSidebar && (
            <nav class="sidebar print:hidden" aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}>
                <MobileMenuToggle />
                <div id="starlight__sidebar" class="sidebar-pane">
                    {Astro.locals.starlightSidebarTopics.isPageWithTopic && (
                        <div class="dropdown-wrapper">
                            <TopicsDropdown />
                        </div>
                    )}
                    <div class="sidebar-content sl-flex">
                        <slot name="sidebar" />
                    </div>
                </div>
            </nav>
        )
    }
    <div class="main-frame"><slot /></div>
    <button class="back-to-top" type="button" aria-label="Back to top" title="Back to top" data-back-to-top>
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 19V5m-6 6 6-6 6 6" />
        </svg>
    </button>
</div>

<script>
    window.addEventListener("load", () => {
        document
            .querySelector(`#starlight__sidebar a[aria-current="page"]`)
            ?.scrollIntoView({ behavior: "smooth", block: "center" });

        const backToTop = document.querySelector<HTMLButtonElement>("[data-back-to-top]");
        if (!backToTop) return;

        const updateBackToTop = () => {
            backToTop.classList.toggle("is-visible", window.scrollY > 480);
        };

        window.addEventListener("scroll", updateBackToTop, { passive: true });
        backToTop.addEventListener("click", () => {
            const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
        });
        updateBackToTop();
    });
</script>

<style>
    .page {
        flex-direction: column;
        min-height: 100vh;
    }

    .header {
        z-index: var(--sl-z-index-navbar);
        position: fixed;
        inset-inline-start: 0;
        inset-block-start: 0;
        width: 100%;
        height: var(--sl-nav-height);
        border-bottom: 1px solid var(--sl-color-hairline-shade);
        padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
        padding-inline-end: var(--sl-nav-pad-x);
        background-color: var(--sl-color-bg-nav);
    }

    :global([data-has-sidebar]) .header {
        padding-inline-start: calc(var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size));
    }

    .sidebar :global(starlight-menu-button button) {
        inset-inline-start: var(--sl-nav-pad-x);
    }

    .sidebar-pane {
        display: flex;
        flex-direction: column;
        visibility: var(--sl-sidebar-visibility, hidden);
        position: fixed;
        z-index: var(--sl-z-index-menu);
        inset-block: var(--sl-nav-height) 0;
        inset-inline-start: 0;
        width: 100%;
        background-color: var(--sl-color-black);
    }

    :global([aria-expanded="true"]) ~ .sidebar-pane {
        --sl-sidebar-visibility: visible;
    }

    .dropdown-wrapper {
        --sl-color-gray-6: oklch(from var(--sl-color-gray-5) calc(l - 0.05) c h);

        padding: var(--sl-sidebar-pad-x);
        background-color: var(--sl-color-black);
        border-bottom: 1px solid var(--sl-color-hairline-light);
    }

    :root[data-theme="light"] .dropdown-wrapper {
        --sl-color-gray-6: oklch(from var(--sl-color-gray-5) calc(l + 0.025) c h);
    }

    .dropdown-wrapper :global(.starlight-sidebar-topics-dropdown-dropdown) {
        width: 100%;
        margin: 0;
    }

    .sidebar-content {
        height: 100%;
        padding: 1rem var(--sl-sidebar-pad-x) 0;
        flex-direction: column;
        gap: 1rem;
        overflow-y: auto;
    }

    .sidebar-content :global(a:not([aria-current="page"]):hover) {
        color: var(--sl-color-accent-high);
    }
    .main-frame :global(.right-sidebar a:hover) {
        color: var(--sl-color-accent-high);
    }

    @media (min-width: 50rem) {
        .sidebar-content::after {
            content: "";
            padding-bottom: 1px;
        }
    }

    .main-frame {
        padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
        padding-inline-start: var(--sl-content-inline-start);
    }

    .page--without-sidebar .main-frame {
        padding-inline-start: 0;
    }

    .page--without-sidebar .header {
        padding-inline-start: var(--sl-nav-pad-x);
    }

    .back-to-top {
        position: fixed;
        z-index: calc(var(--sl-z-index-navbar) - 1);
        inset-inline-end: max(1rem, env(safe-area-inset-right));
        inset-block-end: max(1rem, env(safe-area-inset-bottom));
        display: grid;
        width: 2.85rem;
        height: 2.85rem;
        place-items: center;
        border: 0;
        border-radius: 999px;
        color: #fff;
        background: var(--sl-color-accent);
        box-shadow: 0 10px 28px color-mix(in srgb, var(--sl-color-accent) 36%, transparent);
        opacity: 0;
        pointer-events: none;
        transform: translateY(0.75rem) scale(0.92);
        transition: opacity 180ms ease, transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
        cursor: pointer;
    }

    .back-to-top.is-visible {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0) scale(1);
    }

    .back-to-top:hover {
        background: var(--sl-color-accent-high);
        transform: translateY(-0.2rem) scale(1);
    }

    .back-to-top:focus-visible {
        outline: 3px solid color-mix(in srgb, var(--sl-color-accent-high) 72%, white);
        outline-offset: 3px;
    }

    .back-to-top svg {
        width: 1.35rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.2;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: transform 180ms ease;
    }

    .back-to-top:hover svg {
        transform: translateY(-0.15rem);
    }

    :root[data-theme="light"] .back-to-top {
        color: #fff;
        background: var(--sl-color-accent-high);
        box-shadow: 0 10px 26px rgb(30 58 138 / 16%);
    }

    :root[data-theme="light"] .back-to-top:hover {
        background: var(--sl-color-accent);
    }

    @media (prefers-reduced-motion: reduce) {
        .back-to-top,
        .back-to-top svg {
            transition: none;
        }
    }

    @media (min-width: 50rem) {
        :global([data-has-sidebar]) .header {
            padding-inline-start: var(--sl-nav-pad-x);
        }
        .sidebar-pane {
            --sl-sidebar-visibility: visible;
            width: var(--sl-sidebar-width);
            background-color: var(--sl-color-bg-sidebar);
            border-inline-end: 1px solid var(--sl-color-hairline-shade);
        }
        .dropdown-wrapper {
            background-color: var(--sl-color-bg-sidebar);
        }
    }
</style>
