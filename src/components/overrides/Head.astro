---
const { head, entry } = Astro.locals.starlightRoute;
const canonicalUrl = new URL(Astro.url.pathname, 'https://docs.despical.dev');
const normalizedPath = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const segments = normalizedPath ? normalizedPath.split('/') : [];

const projectNames: Record<string, string> = {
    'advanced-parkour': 'Advanced Parkour',
    'carousel': 'Carousel',
    'command-framework': 'Command Framework',
    'easter-eggs': 'Easter Eggs',
    'eat-everything': 'Eat Everything',
    'item-upgrader': 'Item Upgrader',
    'kotl': 'King of the Ladder',
    'particle-text': 'Particle Text',
    'santa-says': 'Santa Says',
    'spigot-webhook': 'Spigot Sales Webhook',
    'the-snake': 'The Snake',
    'tnt-run': 'TNT Run',
    'tnt-tag': 'TNT Tag',
    'warden-party': 'Warden Party',
    'whack-me': 'Whack Me',
};

const projectName = projectNames[segments[0]];
const pageTitle = projectName && segments.length > 1
    ? `${entry.data.title} | ${projectName}`
    : undefined;

const resolvedHead = head.map((item) => {
    if (!pageTitle) return item;

    if (item.tag === 'title') {
        return { ...item, content: pageTitle };
    }

    if (
        item.tag === 'meta' &&
        (item.attrs?.property === 'og:title' || item.attrs?.name === 'twitter:title')
    ) {
        return { ...item, attrs: { ...item.attrs, content: pageTitle } };
    }

    return item;
});

const schemas: Record<string, unknown>[] = [];

if (segments.length === 0) {
    schemas.push({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'Despical Docs',
        alternateName: ['Despical Documentation', 'docs.despical.dev'],
        url: canonicalUrl.href,
        description: entry.data.description,
    });
}

if (segments.length > 0) {
    const breadcrumbItems: Record<string, unknown>[] = [
        {
            '@type': 'ListItem',
            position: 1,
            name: 'Despical Docs',
            item: 'https://docs.despical.dev/',
        },
    ];

    if (projectName && segments.length > 1) {
        breadcrumbItems.push({
            '@type': 'ListItem',
            position: 2,
            name: `${projectName} Documentation`,
            item: `https://docs.despical.dev/${segments[0]}/`,
        });
    }

    breadcrumbItems.push({
        '@type': 'ListItem',
        position: breadcrumbItems.length + 1,
        name: entry.data.title,
        item: canonicalUrl.href,
    });

    schemas.push({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbItems,
    });
}
---

{resolvedHead.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
{segments.length === 0 && (
    <link
        rel="preload"
        href="/images/home-hero-voxel-world.webp"
        as="image"
        type="image/webp"
        fetchpriority="high"
    />
)}
{schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
