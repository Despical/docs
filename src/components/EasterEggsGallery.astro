---
import gallery from '../data/easter-eggs-gallery.json';
---

<egg-template-gallery>
    <div class="gallery-toolbar">
        <label for="egg-template-search">Find a template</label>
        <input id="egg-template-search" type="search" placeholder="Name, template ID or particle preset" autocomplete="off" />
        <span class="gallery-count" aria-live="polite">20 templates</span>
    </div>
    <div class="template-grid">
        {gallery.templates.map((template) => (
            <figure id={`template-${template.id}`} class="template-card" data-search={`${template.name} ${template.id} ${template.preset}`.toLowerCase()}>
                <video controls loop muted playsinline preload="none" poster={`/images/easter-eggs/templates/${template.id}.png`} width="960" height="720" aria-label={`${template.name}: six-second in-game particle animation`}>
                    <source src={`/images/easter-eggs/templates/${template.id}.webm`} type="video/webm" />
                    <a href={`/images/easter-eggs/templates/${template.id}.webm`}>Watch the {template.name} recording</a>
                </video>
                <figcaption>
                    <strong>{template.name}</strong>
                    <code>{template.id}</code>
                    <span>{template.rendering === 'DISPLAY' ? 'Floating display' : 'Placed head'} · {template.preset}</span>
                    <a href={`/images/easter-eggs/templates/${template.id}.png`} target="_blank" rel="noreferrer">Open screenshot</a>
                </figcaption>
            </figure>
        ))}
    </div>
    <p class="no-results" hidden>No templates match your search.</p>
</egg-template-gallery>

<style>
    egg-template-gallery { display: block; margin-block: 1.5rem; }
    .gallery-toolbar { display: grid; gap: .55rem; margin-bottom: 1.25rem; }
    .gallery-toolbar label { font-weight: 600; }
    .gallery-toolbar input { box-sizing: border-box; width: 100%; padding: .7rem .85rem; border: 1px solid var(--sl-color-gray-4); border-radius: .5rem; background: var(--sl-color-bg); color: var(--sl-color-text); font: inherit; }
    .gallery-toolbar input:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
    .gallery-count { font-size: .85rem; color: var(--sl-color-gray-2); }
    .template-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .template-card { min-width: 0; margin: 0; border: 1px solid var(--sl-color-gray-5); border-radius: .65rem; overflow: hidden; background: var(--sl-color-bg-nav); scroll-margin-top: 7rem; }
    .template-card[hidden], .no-results[hidden] { display: none; }
    .template-card video { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; background: #ddd; }
    figcaption { display: grid; gap: .25rem; padding: .9rem 1rem; font-size: .85rem; }
    figcaption strong { font-size: 1rem; }
    figcaption code { width: fit-content; overflow-wrap: anywhere; }
    figcaption span { color: var(--sl-color-gray-2); overflow-wrap: anywhere; }
    figcaption a { width: fit-content; margin-top: .3rem; }
    @media (max-width: 38rem) { .template-grid { grid-template-columns: 1fr; } }
</style>

<script>
    class EggTemplateGallery extends HTMLElement {
        connectedCallback() {
            if (this.dataset.ready) return;
            this.dataset.ready = 'true';
            const search = this.querySelector<HTMLInputElement>('input[type="search"]');
            const count = this.querySelector<HTMLElement>('.gallery-count');
            const empty = this.querySelector<HTMLElement>('.no-results');
            const cards = Array.from(this.querySelectorAll<HTMLElement>('.template-card'));
            search?.addEventListener('input', () => {
                const query = search.value.trim().toLowerCase();
                let matches = 0;
                cards.forEach((card) => {
                    card.hidden = !card.dataset.search?.includes(query);
                    if (card.hidden) card.querySelector('video')?.pause();
                    else matches++;
                });
                if (count) count.textContent = `${matches} ${matches === 1 ? 'template' : 'templates'}`;
                if (empty) empty.hidden = matches > 0;
            });
            this.querySelectorAll('video').forEach((video) => {
                video.addEventListener('play', () => {
                    this.querySelectorAll('video').forEach((other) => { if (other !== video) other.pause(); });
                });
            });
        }
    }
    if (!customElements.get('egg-template-gallery')) customElements.define('egg-template-gallery', EggTemplateGallery);
</script>
